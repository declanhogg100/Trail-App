{
  "expo": {
    "name": "HoggHikes",
    "slug": "mobile",
    "version": "1.0.0",
    "scheme": "trailapp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.declanhogg.trailapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.declanhogg.trailapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "expo-status-bar",
      "expo-splash-screen",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HoggHikes uses your location to find hikes near you and to track active hikes.",
          "locationAlwaysAndWhenInUsePermission": "HoggHikes tracks your hike's route and distance in the background, even while your phone is locked or the app isn't in view.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-apple-authentication",
      "expo-font",
      "expo-maps",
      "@maplibre/maplibre-react-native",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1818d471-2a9d-47c9-bfdd-642d0c82d667"
      }
    },
    "owner": "pyglett7"
  }
}
