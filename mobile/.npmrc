# a pre-existing react/react-dom peer-dependency mismatch in this project's
# tree causes npm's strict (default) peer resolution to fail -- react-dom
# isn't even used in the native app (only relevant for Expo's optional web
# target), so this is safe to relax rather than worth fighting. Needed here,
# not just locally, because EAS Build runs `npm ci` on its own servers,
# which doesn't know about any flag you ran locally.
legacy-peer-deps=true
