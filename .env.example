# copy this to .env on the server (never commit the real .env) and fill in:

# generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# where the runtime data (DEM tiles, trail parquet files, the SQLite db)
# lives on the server -- just a plain directory on the server's own disk,
# no separate volume needed now that the DEM data fits comfortably on a
# normal droplet's included storage
DATA_ROOT=/opt/trailapp-data
